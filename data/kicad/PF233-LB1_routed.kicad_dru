(version 1)
(rule "general 0.2 mm / 0.15 mm"
  (constraint clearance (min 0.2mm))
  (constraint track_width (min 0.15mm)))
(rule "power width +5V"
  (condition "A.NetName == '+5V'")
  (constraint track_width (min 0.4mm)))
(rule "power width GND"
  (condition "A.NetName == 'GND'")
  (constraint track_width (min 0.4mm)))

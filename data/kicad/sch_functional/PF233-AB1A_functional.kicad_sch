  (text "UA1 AD7389-4 (16-bit, 2 MSPS, four differential inputs, internal reference): inputs ADCIN_* with VCM; unused pairs are parked on VCM." (exclude_from_sim no) (at 22.860 316.830 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "fed6c97f-88bc-5bc7-88bc-df35b244fcc4"))
  (text "VCC and VLOGIC from +3V3D (CVC, CVL 1 uF), REGCAP (CRG), REFCAP (CRC), REFOUT (CRF). 2-wire readout: SDOA (channels A then C) to J2 SDO1, SDOB to J2 SDO2; SDI tied to GND; CS starts a conversion." (exclude_from_sim no) (at 22.860 320.030 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "65a2fdb5-3b06-5934-8493-8b290b4ee8f3"))

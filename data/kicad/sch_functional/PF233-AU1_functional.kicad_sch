  (text "How to read: parts sit in functional blocks (dashed frames). Every pin ends in a short wire with its NET NAME; equal names are connected (also between blocks). A cross = intentionally unconnected pin." (exclude_from_sim no) (at 20.320 10.160 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "c896ccae-63df-5735-af42-d70577f0d114"))
  (text "Diode symbols point anode to cathode. Pin names are those of the library; items marked VERIFY in docs/ASSUMPTIONS.md are unverified. MODELED design: not built, not bench-tested." (exclude_from_sim no) (at 20.320 14.000 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "ff6b54a1-6dbb-5d51-af12-ef1ac5f031e1"))
  (text "PF233-AU1: AU1 audio board: descriptor link, MSPM0G3507 voice synth, TPA2005D1 speaker amp, TPA6132A2 headphone amp, 3-position output selector" (exclude_from_sim no) (at 20.320 4.000 0) (effects (font (size 2.5 2.5) bold) (justify left top)) (uuid "b7e489a1-5408-583c-8a7a-02482ebd1da7"))

(version 1)
(rule "general 0.15 mm / 0.15 mm"
  (constraint clearance (min 0.15mm))
  (constraint track_width (min 0.15mm))
  (constraint hole_size (min 0.3mm))
  (constraint annular_width (min 0.15mm))
  (constraint edge_clearance (min 0.5mm)))
(rule "power width DRAIN1"
  (condition "A.NetName == 'DRAIN1'")
  (constraint track_width (min 1.5mm)))
(rule "HV flyback nets 1.0 mm"
  (condition "A.NetName == 'DRAIN1' || A.NetName == 'CLAMP1'")
  (constraint clearance (min 1.0mm)))

(export (version "E")
  (design (source "PF233-H.net") (date "2026-10-19") (tool "pw_design.py"))
  (components
    (comp (ref "JH") (value "Cable to head: +3V3 GND TRIG DIAL JOYX JOYY SHLD") (footprint "Connector:Pin_header_1x7_P2.54mm") (libsource (lib "PF233") (part "HDR1x7") (description "Pin header 1x7 pitch 2.54")) (property (name "MPN") (value "shielded 6-core + drain")))
    (comp (ref "HS1") (value "SS49E") (footprint "Package_TO_SOT_THT:TO-92_Inline") (libsource (lib "PF233") (part "SS49E") (description "SS49E linear Hall sensor (TO-92 style)")) (property (name "MPN") (value "Honeywell SS49E linear Hall (trigger magnet travel 0-4 mm)")))
    (comp (ref "CH1") (value "100n") (footprint "Capacitor_SMD:C_0603_1608Metric") (libsource (lib "PF233") (part "C0603") (description "Capacitor 0603")) (property (name "MPN") (value "")))
    (comp (ref "RH1") (value "1k") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "")))
    (comp (ref "JJOY") (value "Joystick: V GND X Y SW") (footprint "Connector:Pin_header_1x5_P2.54mm") (libsource (lib "PF233") (part "HDR1x5") (description "Pin header 1x5 pitch 2.54")) (property (name "MPN") (value "2-axis thumb joystick module")))
    (comp (ref "RSW") (value "10k") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "joystick switch pull-up")))
    (comp (ref "JDIAL") (value "Dial: COM P1 P2 P3 P4 (4-position rotary switch)") (footprint "Connector:Pin_header_1x5_P2.54mm") (libsource (lib "PF233") (part "HDR1x5") (description "Pin header 1x5 pitch 2.54")) (property (name "MPN") (value "4-position rotary switch")))
    (comp (ref "RD0") (value "10k") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "")))
    (comp (ref "RD2") (value "3k3") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "")))
    (comp (ref "RD3") (value "10k") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "")))
    (comp (ref "RD4") (value "33k") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "")))
    (comp (ref "RSHH") (value "0R") (footprint "Resistor_SMD:R_0603_1608Metric") (libsource (lib "PF233") (part "R0603") (description "Resistor 0603")) (property (name "MPN") (value "shield to grip foil")))
  )

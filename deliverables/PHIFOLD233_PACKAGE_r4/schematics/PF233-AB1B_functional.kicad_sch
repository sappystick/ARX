  (text "UA1 AD7389-4 (16-bit, 2 MSPS, four differential inputs, internal reference): inputs ADCIN_* with VCM; unused pairs are parked on VCM." (exclude_from_sim no) (at 257.310 225.080 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "8f87d356-9b3a-55ee-85ee-fc1446f3ba6e"))
  (text "VCC and VLOGIC from +3V3D (CVC, CVL 1 uF), REGCAP (CRG), REFCAP (CRC), REFOUT (CRF). 2-wire readout: SDOA (channels A then C) to J2 SDO1, SDOB to J2 SDO2; SDI tied to GND; CS starts a conversion." (exclude_from_sim no) (at 257.310 228.280 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "9d13e7d3-acca-5fcf-86a4-f887a09806dc"))

(version 1)
(rule "general 0.16 mm / 0.15 mm"
  (severity error)
  (constraint clearance (min 0.16mm))
  (constraint track_width (min 0.15mm))
  (constraint hole_size (min 0.3mm))
  (constraint annular_width (min 0.15mm))
  (constraint edge_clearance (min 0.5mm))
  (constraint hole_clearance (min 0.26mm))
  (constraint hole_to_hole (min 0.41mm)))
(rule "component PTH annular 0.18 mm, hole 0.46 mm"
  (severity error)
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.18mm))
  (constraint hole_size (min 0.46mm)))
(rule "power width P3V3"
  (condition "A.NetName == 'P3V3'")
  (constraint track_width (min 0.3mm)))

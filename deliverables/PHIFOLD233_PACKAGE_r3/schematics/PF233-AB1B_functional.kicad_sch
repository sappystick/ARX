  (text "RAW_MONO -> RS2 (series) -> D2 (BAV199 clamp to +5VA / GND) -> SW2 (74LVC1G66; BLANK opens the path) -> IN_MONO -> op-amp U1 half B." (exclude_from_sim no) (at 22.860 177.450 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "87e4d745-dde0-5544-9f13-67608b8dce94"))
  (text "Non-inverting gain stage: RG2 to VCM, RF2 || CF2 feedback; OUT_MONO -> RAAF2 / CAAF2 anti-alias -> ADCIN_MONO -> UA2 (ADS8860, 16-bit SAR; REF = VREF with CRF2)." (exclude_from_sim no) (at 22.860 180.650 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "c99a9522-8708-5f8c-97a7-0b118d9f0321"))
